# Unity / C# 文本文件统一 LF。
# 不钉这个的话，Windows 上的 core.autocrlf 会把 .meta / .unity / .prefab 改成 CRLF，
# Unity 每次打开都以为这些文件被外部改过，反复重导入。
*.cs             text eol=lf
*.meta           text eol=lf
*.unity          text eol=lf
*.prefab         text eol=lf
*.asset          text eol=lf
*.mat            text eol=lf
*.controller     text eol=lf
*.anim           text eol=lf
*.asmdef         text eol=lf
*.json           text eol=lf
*.md             text eol=lf
*.txt            text eol=lf
*.xml            text eol=lf
*.shader         text eol=lf
*.compute        text eol=lf
.gitignore       text eol=lf
.gitattributes   text eol=lf

# 二进制资源不要做行尾转换，也不要尝试 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.psd   binary
*.tga   binary
*.exr   binary
*.ttf   binary
*.otf   binary
*.fbx   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.dll   binary
*.so    binary
*.dylib binary
